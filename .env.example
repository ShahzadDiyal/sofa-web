# ── MySQL (the database — replaces Firestore) ─────────────────────────
# Live app on Hostinger (Node.js web app, same machine as the database):
#   DATABASE_URL=mysql://uXXXX_sofaweb:<password>@localhost:3306/uXXXX_sofaweb
# Local dev on your own machine (hPanel → Databases → Remote MySQL first):
#   DATABASE_URL=mysql://uXXXX_sofaweb:<password>@<mysql-hostname>:3306/uXXXX_sofaweb
# NOTE: if the password contains special characters (@ : / ? #), URL-encode
# them (e.g. @ becomes %40).
DATABASE_URL=

# ── Firebase (one-time import only — scripts/import-firestore-to-mysql.mjs)
# Create a service account in Firebase Console → Project settings →
# Service accounts → Generate new private key, then paste the values here.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Firebase (client / web SDK — optional, for future client features) ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Site ────────────────────────────────────────────────────────────────
# Public URL of the deployed site (used for canonical URLs, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://sofora.example

# ── Cloudinary (server-side signed uploads for admin image uploads) ──
# Cloudinary dashboard → Settings → API Keys. Needed for "upload from device"
# in admin (products, categories, colors). Add the same three on hosting.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Admin allow-list (Firebase Auth gate for /admin) ──
# Secret used to sign admin session cookies. REQUIRED in production —
# the server refuses to start admin sessions without it. In local dev a
# fixed dev secret is used when empty, so sign-in survives restarts.
ADMIN_SESSION_SECRET=

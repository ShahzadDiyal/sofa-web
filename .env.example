# ── Firebase (server / Admin SDK — used by API routes) ──────────────
# Create a service account in Firebase Console → Project settings →
# Service accounts → Generate new private key, then paste the values here.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Firebase (client / web SDK — optional, for future client features) ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Site ────────────────────────────────────────────────────────────────
# Public URL of the deployed site (used for canonical URLs, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://sofora.example
